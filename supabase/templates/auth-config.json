{
  "mailer_subjects_confirmation": "Confirme seu e-mail — OrganizaCasamento",
  "mailer_templates_confirmation_content": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirme seu e-mail</title></head><body style=\"margin:0;background:#f8f7f3;color:#343d35;font-family:Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" style=\"max-width:560px;background:white;border:1px solid #e8e3d9;border-radius:16px\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:32px\"><p style=\"color:#596d50;font-weight:bold;font-size:20px;margin:0 0 32px\">OrganizaCasamento</p><h1 style=\"font-size:26px;line-height:1.3\">Confirme seu e-mail para começar</h1><p style=\"font-size:16px;line-height:1.7\">Confirme o endereço <strong>{{ .Email }}</strong> para acessar seu controle do casamento.</p><p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#596d50;color:white;text-decoration:none;padding:16px 22px;border-radius:8px;font-weight:bold\">Confirmar meu e-mail</a></p><p style=\"font-size:14px;line-height:1.7\">Se você não criou esta conta, ignore esta mensagem.</p><p style=\"font-size:13px;line-height:1.7;color:#667064\">O link é de uso único. Se estiver expirado, volte ao site para solicitar outro.</p><p style=\"font-size:12px;line-height:1.6;word-break:break-all\">Se o botão não abrir, copie este endereço para seu navegador:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#596d50\">{{ .ConfirmationURL }}</a></p><hr style=\"border:0;border-top:1px solid #e8e3d9;margin:28px 0\"><p style=\"font-size:12px;color:#667064\">Seu casamento, sem complicação.<br>Nunca pediremos sua senha por e-mail.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_recovery": "Crie uma nova senha — OrganizaCasamento",
  "mailer_templates_recovery_content": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Crie uma nova senha</title></head><body style=\"margin:0;background:#f8f7f3;color:#343d35;font-family:Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" style=\"max-width:560px;background:white;border:1px solid #e8e3d9;border-radius:16px\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:32px\"><p style=\"color:#596d50;font-weight:bold;font-size:20px;margin:0 0 32px\">OrganizaCasamento</p><h1 style=\"font-size:26px;line-height:1.3\">Vamos criar uma nova senha?</h1><p style=\"font-size:16px;line-height:1.7\">Recebemos um pedido para redefinir a senha da conta <strong>{{ .Email }}</strong>. Clique abaixo e escolha uma nova senha.</p><p style=\"margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#596d50;color:white;text-decoration:none;padding:16px 22px;border-radius:8px;font-weight:bold\">Criar nova senha</a></p><p style=\"font-size:14px;line-height:1.7\">Se você não pediu a alteração, ignore este e-mail. Sua senha continua a mesma.</p><p style=\"font-size:13px;line-height:1.7;color:#667064\">O link é de uso único. Se estiver expirado, volte ao site para solicitar outro.</p><p style=\"font-size:12px;line-height:1.6;word-break:break-all\">Se o botão não abrir, copie este endereço para seu navegador:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#596d50\">{{ .ConfirmationURL }}</a></p><hr style=\"border:0;border-top:1px solid #e8e3d9;margin:28px 0\"><p style=\"font-size:12px;color:#667064\">Seu casamento, sem complicação.<br>Nunca pediremos sua senha por e-mail.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_subjects_password_changed_notification": "Sua senha foi alterada — OrganizaCasamento",
  "mailer_templates_password_changed_notification_content": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Sua senha foi alterada</title></head><body style=\"margin:0;background:#f8f7f3;color:#343d35;font-family:Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" style=\"max-width:560px;background:white;border:1px solid #e8e3d9;border-radius:16px\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:32px\"><p style=\"color:#596d50;font-weight:bold;font-size:20px;margin:0 0 32px\">OrganizaCasamento</p><h1 style=\"font-size:26px;line-height:1.3\">Sua senha foi alterada</h1><p style=\"font-size:16px;line-height:1.7\">A senha da conta <strong>{{ .Email }}</strong> foi alterada. Use a nova senha nos próximos acessos.</p><p style=\"margin:28px 0\"><a href=\"{{ .SiteURL }}/acesso/recuperar\" style=\"display:inline-block;background:#596d50;color:white;text-decoration:none;padding:16px 22px;border-radius:8px;font-weight:bold\">Recuperar minha conta</a></p><p style=\"font-size:14px;line-height:1.7\">Se não foi você, use o botão acima para recuperar sua conta imediatamente.</p><hr style=\"border:0;border-top:1px solid #e8e3d9;margin:28px 0\"><p style=\"font-size:12px;color:#667064\">Seu casamento, sem complicação.<br>Nunca pediremos sua senha por e-mail.</p></td></tr></table></td></tr></table></body></html>",
  "mailer_notifications_password_changed_enabled": true
}

{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "organiza-casamento": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["public/fonts/fonts.css", "src/styles.scss"],
            "allowedCommonJsDependencies": [
              "core-js",
              "raf",
              "rgbcolor",
              "html2canvas",
              "qrcode",
              "dijkstrajs"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.testing.ts"
                },
                {
                  "replace": "src/app/core/repositories/app.repository.ts",
                  "with": "src/testing/core/repositories/app.repository.ts"
                },
                {
                  "replace": "src/app/core/repositories/suppliers.repository.ts",
                  "with": "src/testing/core/repositories/suppliers.repository.ts"
                },
                {
                  "replace": "src/app/core/repositories/invitations.repository.ts",
                  "with": "src/testing/core/repositories/invitations.repository.ts"
                },
                {
                  "replace": "src/app/core/repositories/delete-wedding.ts",
                  "with": "src/testing/core/repositories/delete-wedding.ts"
                },
                {
                  "replace": "src/app/core/services/gifts.ts",
                  "with": "src/testing/core/services/gifts.ts"
                },
                {
                  "replace": "src/app/core/services/temporary-data.ts",
                  "with": "src/testing/core/services/temporary-data.ts"
                },
                {
                  "replace": "src/app/shared/components/temporary-data-panel.ts",
                  "with": "src/testing/shared/components/temporary-data-panel.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "organiza-casamento:build:production"
            },
            "development": {
              "buildTarget": "organiza-casamento:build:development"
            },
            "testing": {
              "buildTarget": "organiza-casamento:build:testing"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "organiza-casamento:build:testing"
          }
        }
      }
    }
  }
}
